{
  "name": "cli-commit-message",
  "displayName": "CLI Commit Message",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "takato",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "l10n": "./l10n",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "categories": [
    "SCM Providers",
    "AI"
  ],
  "keywords": [
    "git",
    "commit",
    "commit message",
    "scm",
    "ai",
    "claude",
    "codex",
    "gemini",
    "cli",
    "conventional commits"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tqkqt0/cli-commit-message.git"
  },
  "bugs": {
    "url": "https://github.com/tqkqt0/cli-commit-message/issues"
  },
  "homepage": "https://github.com/tqkqt0/cli-commit-message#readme",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cliCommitMsg.generate",
        "title": "%command.generate%",
        "category": "CLI Commit",
        "icon": "$(sparkle)"
      },
      {
        "command": "cliCommitMsg.abort",
        "title": "%command.abort%",
        "category": "CLI Commit",
        "icon": "$(stop-circle)"
      },
      {
        "command": "cliCommitMsg.showLog",
        "title": "%command.showLog%",
        "category": "CLI Commit"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "cliCommitMsg.generate",
          "group": "navigation",
          "when": "scmProvider == git && !cliCommitMsg.generating"
        },
        {
          "command": "cliCommitMsg.abort",
          "group": "navigation",
          "when": "scmProvider == git && cliCommitMsg.generating"
        }
      ],
      "commandPalette": [
        {
          "command": "cliCommitMsg.abort",
          "when": "cliCommitMsg.generating"
        }
      ]
    },
    "configuration": {
      "title": "CLI Commit Message",
      "properties": {
        "cliCommitMsg.provider": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "gemini"
          ],
          "enumDescriptions": [
            "%config.provider.claude%",
            "%config.provider.codex%",
            "%config.provider.gemini%"
          ],
          "default": "claude",
          "order": 1,
          "markdownDescription": "%config.provider%"
        },
        "cliCommitMsg.language": {
          "type": "string",
          "enum": [
            "English",
            "日本語",
            "简体中文",
            "한국어",
            "Español",
            "Français",
            "Deutsch",
            "Português"
          ],
          "default": "English",
          "order": 2,
          "markdownDescription": "%config.language%"
        },
        "cliCommitMsg.model": {
          "type": "string",
          "enum": [
            "haiku",
            "sonnet",
            "opus"
          ],
          "enumDescriptions": [
            "%config.model.haiku%",
            "%config.model.sonnet%",
            "%config.model.opus%"
          ],
          "default": "sonnet",
          "order": 3,
          "markdownDescription": "%config.model%"
        },
        "cliCommitMsg.codexModel": {
          "type": "string",
          "default": "",
          "order": 4,
          "markdownDescription": "%config.codexModel%"
        },
        "cliCommitMsg.geminiModel": {
          "type": "string",
          "default": "",
          "order": 5,
          "markdownDescription": "%config.geminiModel%"
        },
        "cliCommitMsg.instructions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Follow the Conventional Commits format: a type prefix (feat, fix, docs, style, refactor, perf, test, chore) followed by a concise subject line.",
            "After the subject line, leave a blank line and explain what changed and why, as bullet points."
          ],
          "order": 6,
          "markdownDescription": "%config.instructions%"
        },
        "cliCommitMsg.promptTemplate": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Below is a git diff. Write exactly one commit message for this change.",
            "",
            "Rules:",
            "${instructions}",
            "",
            "Output format:",
            "- Output the commit message body only.",
            "- Do not add any preamble, postscript, code fence, quotes or headings."
          ],
          "order": 7,
          "markdownDescription": "%config.promptTemplate%"
        },
        "cliCommitMsg.diffScope": {
          "type": "string",
          "enum": [
            "stagedOrAll",
            "stagedOnly"
          ],
          "enumDescriptions": [
            "%config.diffScope.stagedOrAll%",
            "%config.diffScope.stagedOnly%"
          ],
          "default": "stagedOrAll",
          "order": 8,
          "markdownDescription": "%config.diffScope%"
        },
        "cliCommitMsg.includeUntracked": {
          "type": "boolean",
          "default": true,
          "order": 9,
          "markdownDescription": "%config.includeUntracked%"
        },
        "cliCommitMsg.maxDiffBytes": {
          "type": "number",
          "default": 400000,
          "minimum": 0,
          "order": 10,
          "markdownDescription": "%config.maxDiffBytes%"
        },
        "cliCommitMsg.onExistingMessage": {
          "type": "string",
          "enum": [
            "replace",
            "append",
            "keep"
          ],
          "enumDescriptions": [
            "%config.onExistingMessage.replace%",
            "%config.onExistingMessage.append%",
            "%config.onExistingMessage.keep%"
          ],
          "default": "replace",
          "order": 11,
          "markdownDescription": "%config.onExistingMessage%"
        },
        "cliCommitMsg.claudePath": {
          "type": "string",
          "default": "claude",
          "order": 12,
          "markdownDescription": "%config.claudePath%"
        },
        "cliCommitMsg.codexPath": {
          "type": "string",
          "default": "codex",
          "order": 13,
          "markdownDescription": "%config.codexPath%"
        },
        "cliCommitMsg.geminiPath": {
          "type": "string",
          "default": "gemini",
          "order": 14,
          "markdownDescription": "%config.geminiPath%"
        },
        "cliCommitMsg.runInNeutralCwd": {
          "type": "boolean",
          "default": true,
          "order": 15,
          "markdownDescription": "%config.runInNeutralCwd%"
        }
      }
    }
  }
}
